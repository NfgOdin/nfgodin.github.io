---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Giscus from '@components/Giscus.astro';

export async function getStaticPaths() {
  const all = (await getCollection('tutorials')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, idx) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      all,
      prev: idx > 0 ? all[idx - 1] : null,
      next: idx < all.length - 1 ? all[idx + 1] : null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'tutorials'>;
  all: CollectionEntry<'tutorials'>[];
  prev: CollectionEntry<'tutorials'> | null;
  next: CollectionEntry<'tutorials'> | null;
}

const { entry, all, prev, next } = Astro.props;
const { Content, headings } = await entry.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const groupedCategories = Array.from(new Set(all.map((t) => t.data.category)));
---

<BaseLayout title={`${entry.data.title} — Tutorial`} description={entry.data.summary}>
  <div class="container" style="padding-top: 1.75rem;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/tutorials/">Tutorials</a>
      <span class="sep">/</span>
      <span>{entry.data.category}</span>
      <span class="sep">/</span>
      <span class="current">{entry.data.title}</span>
    </nav>

    <div class="tutorial-layout">
      <!-- Left Guide Index Sidebar -->
      <aside class="explorer-sidebar" aria-label="All Guides">
        <a href="/tutorials/" class="sidebar-btn" style="margin-bottom:0.25rem;">
          <span>&larr; All Tutorials</span>
        </a>
        {groupedCategories.map((cat) => (
          <div>
            <div class="sidebar-label">{cat}</div>
            <div class="sidebar-list">
              {all
                .filter((g) => g.data.category === cat)
                .map((g) => (
                  <a
                    href={`/tutorials/${g.slug}/`}
                    class={`sidebar-btn sidebar-sub-btn ${g.slug === entry.slug ? 'active' : ''}`}
                  >
                    <span>{g.data.title}</span>
                  </a>
                ))}
            </div>
          </div>
        ))}
      </aside>

      <!-- Main Article Reader -->
      <div style="min-width:0;">
        <article class="tutorial-article">
          <header style="margin-bottom:1.85rem;padding-bottom:1.35rem;border-bottom:1px solid var(--border-hairline);">
            <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.8rem;">
              <span class="chip chip-emerald">{entry.data.category}</span>
              <span class="chip">{entry.data.subcategory}</span>
              <span class="chip chip-cyan">{entry.data.platform}</span>
              <span class="chip">{entry.data.difficulty}</span>
              <span class="mono" style="font-size:0.74rem;color:var(--text-muted);margin-left:auto;">
                {entry.data.readingTime}
              </span>
            </div>

            <h1 class="page-title" style="font-size:clamp(1.7rem,3vw,2.35rem);">{entry.data.title}</h1>
            <p style="color:var(--text-secondary);font-size:0.98rem;margin-top:0.55rem;">{entry.data.summary}</p>

            {entry.data.projectUrl && (
              <div style="margin-top:1rem;">
                <a href={entry.data.projectUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                  View Source Repository &rarr;
                </a>
              </div>
            )}
          </header>

          <div class="prose" id="tutorial-prose">
            <Content />
          </div>

          {(prev || next) && (
            <nav
              aria-label="Tutorial pagination"
              style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.85rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--border-hairline);"
            >
              {prev ? (
                <a href={`/tutorials/${prev.slug}/`} class="card" style="padding:0.95rem 1.1rem;text-decoration:none;">
                  <span class="mono" style="font-size:0.68rem;color:var(--text-muted);">&larr; Previous Guide</span>
                  <span style="font-weight:600;font-size:0.92rem;margin-top:0.2rem;">{prev.data.title}</span>
                </a>
              ) : <div />}
              {next && (
                <a href={`/tutorials/${next.slug}/`} class="card" style="padding:0.95rem 1.1rem;text-decoration:none;text-align:right;">
                  <span class="mono" style="font-size:0.68rem;color:var(--text-muted);">Next Guide &rarr;</span>
                  <span style="font-weight:600;font-size:0.92rem;margin-top:0.2rem;">{next.data.title}</span>
                </a>
              )}
            </nav>
          )}
        </article>

        <Giscus
          eyebrow="Guide Q&A"
          title="Questions &amp; Troubleshooting"
          subtitle="Stuck on a step or have a tip to share? Post directly in GitHub Discussions below."
        />
      </div>

      <!-- Sticky Table of Contents -->
      {tocHeadings.length > 0 && (
        <aside class="toc-box" aria-label="On this page">
          <div class="sidebar-label">On This Page</div>
          <ul class="toc-list">
            {tocHeadings.map((h) => (
              <li>
                <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </div>

  <script is:inline>
    (() => {
      const prose = document.getElementById('tutorial-prose');
      if (!prose) return;
      prose.querySelectorAll('pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent || pre.textContent || '';
          try {
            await navigator.clipboard.writeText(code.trim());
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
          } catch {}
        });
        pre.appendChild(btn);
      });
    })();
  </script>
</BaseLayout>
