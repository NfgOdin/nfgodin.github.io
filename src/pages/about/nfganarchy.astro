---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="NfgAnarchy — Profile" description="NfgAnarchy creator profile at NFG Collective (Work in Progress).">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/about/">About</a>
        <span class="sep">/</span>
        <span class="current">NfgAnarchy</span>
      </nav>
      <a href="/about/" class="btn btn-secondary btn-sm">&larr; Back to About</a>
    </div>
  </section>

  <div class="container" style="padding-bottom: 5rem;">
    <article class="bio-card" style="text-align:center;max-width:720px;margin:0 auto;padding:3rem 2rem;">
      <span class="chip chip-amber" style="margin-bottom:1rem;">Work in Progress</span>
      <h1 class="page-title" style="margin-bottom:0.75rem;">NfgAnarchy</h1>
      <p style="max-width:54ch;margin:0 auto 1.75rem;">
        This profile is currently under construction. Check back soon for NfgAnarchy's full biography, projects, and contributions to the NFG Collective!
      </p>
      <a href="/about/" class="btn btn-primary">Return to NFG Collective</a>
    </article>
  </div>
</BaseLayout>
