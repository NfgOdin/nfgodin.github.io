      <button type="button" class="icon-btn mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle Menu" aria-expanded="false">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <ul class="mobile-drawer-links">
    <li><a href="/" class={`nav-link ${isActive('/') ? 'active' : ''}`}>Home</a></li>
    <li><a href="/projects/" class={`nav-link ${isActive('/projects') ? 'active' : ''}`}>Projects &amp; PC Ports</a></li>
    <li><a href="/tutorials/" class={`nav-link ${isActive('/tutorials') ? 'active' : ''}`}>Tutorials</a></li>
    <li><a href="/about/" class={`nav-link ${isActive('/about') ? 'active' : ''}`}>About NFG</a></li>
  </ul>
  <div class="mobile-drawer-socials">
    <a href="https://github.com/NfgOdin" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">GitHub</a>
    <a href="https://www.nexusmods.com/profile/NfgOdin" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Nexus Mods</a>
    <a href="https://www.curseforge.com/members/nfgodin/projects" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">CurseForge</a>
  </div>
</div>

<script is:inline>
  (() => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (toggle && drawer) {
      toggle.addEventListener('click', () => {
        const open = drawer.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        drawer.setAttribute('aria-hidden', String(!open));
      });
    }
  })();
</script>
