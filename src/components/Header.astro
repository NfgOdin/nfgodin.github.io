---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (prefix: string) => {
  if (prefix === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(prefix);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link">
      <img src="/images/logo.png" alt="NFG Crest" class="brand-logo" width="38" height="38" />
      <span class="brand-text">
        <span class="brand-title">NFG</span>
        <span class="brand-sub">Systems &amp; Game Tech</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        <li><a href="/" class={`nav-link ${isActive('/') ? 'active' : ''}`}>Home</a></li>
        <li><a href="/projects/" class={`nav-link ${isActive('/projects') ? 'active' : ''}`}>Projects</a></li>
        <li><a href="/tutorials/" class={`nav-link ${isActive('/tutorials') ? 'active' : ''}`}>Tutorials</a></li>
        <li><a href="/about/" class={`nav-link ${isActive('/about') ? 'active' : ''}`}>About</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="cmdk-trigger" id="open-cmdk-btn" aria-label="Open command search (Ctrl+K)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="cmdk-label-text">Search</span>
        <kbd class="cmdk-kbd">Ctrl K</kbd>
      </button>

      <button type="button" class="donate-pill" id="open-donate-btn" aria-label="Support NFG via PayPal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        <span>Donate</span>
      </button>

      <div class="header-social-group" style="display: inline-flex; gap: 0.4rem;">
